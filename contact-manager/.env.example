# PostgreSQL connection string.
# Locally: point this at a local Postgres instance, e.g.
#   postgresql://postgres:postgres@localhost:5432/contact_manager
# In production (Railway or another host): use your Postgres provider's URL,
# which usually looks like:
#   postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/contact_manager

# Some providers expose the connection string as POSTGRES_URL instead.
# lib/db.ts reads POSTGRES_URL first, then falls back to DATABASE_URL.
# POSTGRES_URL=

# Server-side URL of the agent service. Local development uses localhost;
# Railway should use the agent service's private domain and port.
AGENT_SERVICE_URL=http://localhost:8000
